S/* Check of parameters for configuration of ADC hierarchical scope:           */
S/* common to several ADC instances.                                           */
S#define IS_LL_ADC_COMMON_CLOCK(__CLOCK__)                                      \
S  (   ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV2)                             \
S   || ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV4)                             \
S   || ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV6)                             \
S   || ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV8)                             \
S  )
X#define IS_LL_ADC_COMMON_CLOCK(__CLOCK__)                                        (   ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV2)                                || ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV4)                                || ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV6)                                || ((__CLOCK__) == LL_ADC_CLOCK_SYNC_PCLK_DIV8)                               )
S
